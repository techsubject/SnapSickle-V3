{
  "manifest_version": 3,
  "name": "SnapSickle Grid Snap",
  "version": "3.0.0",
  "description": "Adjust DashCraft X/Z and Y snapping, grid spacing, vertical placement, and rotation steps.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://dashcraft.io/*"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dashcraft.io/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://dashcraft.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}